msgstr "いいえ"

#: usr/lib/live-installer/dialogs.py:49
msgid "Yes"
msgstr "はい"

#: usr/lib/live-installer/installer.py:185
#: usr/lib/live-installer/installer.py:377
msgid "Adding new user to the system"
msgstr "システムに新しいユーザーを追加しています"

#: usr/lib/live-installer/installer.py:188
#: usr/lib/live-installer/installer.py:641
msgid "Setting hostname"
msgstr "ホスト名を設定しています"

#: usr/lib/live-installer/installer.py:191
#: usr/lib/live-installer/installer.py:644
msgid "Setting locale"
msgstr "地域と言語を設定しています"

#: usr/lib/live-installer/installer.py:194
#: usr/lib/live-installer/installer.py:647
msgid "Setting timezone"
msgstr "タイムゾーンを設定しています"

#: usr/lib/live-installer/installer.py:197
#: usr/lib/live-installer/installer.py:650
msgid "Localizing packages"
msgstr "パッケージの言語を構成しています"

#: usr/lib/live-installer/installer.py:200
#: usr/lib/live-installer/installer.py:685
msgid "Setting keyboard options"
msgstr "キーボードのオプションを設定しています"

#: usr/lib/live-installer/installer.py:203
#: usr/lib/live-installer/installer.py:756
msgid "Cleaning APT"
msgstr "APT を掃除しています"

#: usr/lib/live-installer/installer.py:208
msgid "Cleaning OEM configuration"
msgstr "OEM 構成を掃除しています"

#: usr/lib/live-installer/installer.py:216
#: usr/lib/live-installer/installer.py:789 usr/lib/live-installer/main.py:1437
msgid "Installation finished"
msgstr "インストールが完了しました"

#: usr/lib/live-installer/installer.py:226
msgid ""
"ERROR: You must first manually mount your target filesystem(s) at /target to "
"do a custom install!"
msgstr ""
"エラー: カスタムインストールを実行する前に、まず対象のファイルシステムを /"
"target にマウントしてください！"

#: usr/lib/live-installer/installer.py:242
msgid "Mounting partitions..."
msgstr "パーティションをマウントしています..."

#: usr/lib/live-installer/installer.py:246
msgid "Live medium not found!"
msgstr "ライブメディアが見つかりませんでした！"

#: usr/lib/live-installer/installer.py:298
msgid "Copying files..."
msgstr "ファイルをコピーしています..."

#: usr/lib/live-installer/installer.py:303
msgid "Entering the system..."
msgstr "システムに入っています..."

#: usr/lib/live-installer/installer.py:358
msgid "Removing live configuration (packages)"
msgstr "ライブ構成 (パッケージ) を削除しています"

#: usr/lib/live-installer/installer.py:387
msgid "Writing filesystem mount information to /etc/fstab"
msgstr "ファイルシステムのマウント情報を /etc/fstab に書き込んでいます"

#: usr/lib/live-installer/installer.py:424
#, python-format
msgid "Creating partitions on %s"
msgstr "%s にパーティションを作成しています"

#: usr/lib/live-installer/installer.py:445
#: usr/lib/live-installer/partitioning.py:559
#, python-format
msgid ""
"The partition %s could not be formatted. The installation will stop. Restart "
"the computer and try again."
msgstr ""
"パーティション %s をフォーマットできませんでした。インストールを中止します。"
"再起動してやり直してください。"

#: usr/lib/live-installer/installer.py:495
msgid "Formatting partitions..."
msgstr "パーティションをフォーマットしています..."

#: usr/lib/live-installer/installer.py:521
#, python-format
msgid "Mounting %(partition)s on %(mountpoint)s"
msgstr "%(partition)s を %(mountpoint)s にマウントしています"

#: usr/lib/live-installer/installer.py:656
msgid "Installing drivers"
msgstr "ドライバーをインストールしています"

#: usr/lib/live-installer/installer.py:714
msgid "Installing bootloader"
msgstr "ブートローダーをインストールしています"

#: usr/lib/live-installer/installer.py:727
msgid ""
"WARNING: The grub bootloader was not configured properly! You need to "
"configure it manually."
msgstr ""
"警告: GRUB ブートローダーを正しく構成できなかったため、手動での設定が必要で"
"す。"

#: usr/lib/live-installer/installer.py:798
msgid "Configuring bootloader"
msgstr "ブートローダーを構成しています"

#: usr/lib/live-installer/installer.py:807
msgid "Checking bootloader"
msgstr "ブートローダーを確認しています"

#: usr/lib/live-installer/main.py:138 usr/lib/live-installer/main.py:377
#: usr/lib/live-installer/main.py:417
msgid "Language"
msgstr "言語"

#: usr/lib/live-installer/main.py:258 usr/lib/live-installer/main.py:422
msgid "Layout"
msgstr "レイアウト"

#: usr/lib/live-installer/main.py:265 usr/lib/live-installer/main.py:423
msgid "Variant"
msgstr "系統"

#: usr/lib/live-installer/main.py:359 usr/lib/live-installer/main.py:1146
#: usr/lib/live-installer/main.py:1159 usr/lib/live-installer/main.py:1226
#: usr/lib/live-installer/main.py:1230 usr/lib/live-installer/main.py:1249
#: usr/lib/live-installer/main.py:1252 usr/lib/live-installer/main.py:1259
#: usr/lib/live-installer/main.py:1263 usr/lib/live-installer/main.py:1271
msgid "Installer"
msgstr "インストーラー"

#: usr/lib/live-installer/main.py:363
msgid "Initial Setup"
msgstr "初期設定"

#: usr/lib/live-installer/main.py:377
msgid "What language would you like to use?"
msgstr "どの言語で使用しますか？"

#: usr/lib/live-installer/main.py:378
msgid "Timezone"
msgstr "タイムゾーン"

#: usr/lib/live-installer/main.py:378
msgid "Where are you?"
msgstr "どこに住んでいますか？"

#: usr/lib/live-installer/main.py:379
msgid "Keyboard layout"
msgstr "キーボードのレイアウト"

#: usr/lib/live-installer/main.py:379
msgid "What is your keyboard layout?"
msgstr "キーボードの配列はどれですか？"

#: usr/lib/live-installer/main.py:380
msgid "User account"
msgstr "ユーザーアカウント"

#: usr/lib/live-installer/main.py:380
msgid "Who are you?"
msgstr "あなたの情報を入力してください"

#: usr/lib/live-installer/main.py:381
msgid "Installation Type"
msgstr "インストールの方法"

#: usr/lib/live-installer/main.py:381 usr/lib/live-installer/main.py:382
#, python-format
msgid "Where do you want to install %s?"
msgstr "どこに %s をインストールしますか？"

#: usr/lib/live-installer/main.py:382
msgid "Partitioning"
msgstr "パーティショニング"

#: usr/lib/live-installer/main.py:383
msgid "Advanced options"
msgstr "高度なオプション"

#: usr/lib/live-installer/main.py:383
msgid "Configure the boot menu"
msgstr "ブートメニューを構成します"

#: usr/lib/live-installer/main.py:384
msgid "Summary"
msgstr "概要"

#: usr/lib/live-installer/main.py:384
msgid "Check that everything is correct"
msgstr "内容に間違いがないかを確認してください"

#: usr/lib/live-installer/main.py:385
msgid "Installing"
msgstr "インストールしています"

#: usr/lib/live-installer/main.py:386 usr/lib/live-installer/main.py:464
#: usr/share/live-installer/interface.ui:1462
msgid "Expert mode"
msgstr "上級者モード"

#: usr/lib/live-installer/main.py:387 usr/lib/live-installer/main.py:1452
msgid "Installation paused"
msgstr "インストールを一時停止しました"

#: usr/lib/live-installer/main.py:390
msgid "Quit"
msgstr "終了"

#: usr/lib/live-installer/main.py:391
msgid "Back"
msgstr "戻る"

#: usr/lib/live-installer/main.py:392 usr/lib/live-installer/main.py:1311
#: usr/lib/live-installer/main.py:1447
msgid "Next"
msgstr "次へ"

#: usr/lib/live-installer/main.py:399
msgid "Welcome to your new computer!"
msgstr "新しいコンピューターにようこそ！"

#: usr/lib/live-installer/main.py:400
msgid "Start"
msgstr "開始"

#: usr/lib/live-installer/main.py:418 usr/share/live-installer/interface.ui:412
msgid "Location"
msgstr "場所"

#: usr/lib/live-installer/main.py:421 usr/share/live-installer/interface.ui:694
msgid "Keyboard Model:"
msgstr "キーボードの型式:"

#: usr/lib/live-installer/main.py:424 usr/share/live-installer/interface.ui:797
msgid "Type here to test your keyboard layout"
msgstr "ここでキーボードレイアウトの設定を試せます"

#: usr/lib/live-installer/main.py:426
msgid ""
"* Your username, your computer's name and your password should only contain "
"Latin characters. In addition to your selected layout, English (US) is set "
"as the default. You can switch layouts by pressing Super+Space."
msgstr ""
"* ユーザー名・コンピューター名・パスワードには、英数字のみが使用できます。選"
"択したレイアウトに加えて、English (US) が既定のレイアウトとして設定されます。"
"Super+Space を押すと、レイアウトを切り替えられます。"

#: usr/lib/live-installer/main.py:429 usr/share/live-installer/interface.ui:839
msgid "Your name:"
msgstr "名前:"

#: usr/lib/live-installer/main.py:430 usr/share/live-installer/interface.ui:882
msgid "Your computer's name:"
msgstr "コンピューター名:"

#: usr/lib/live-installer/main.py:431 usr/share/live-installer/interface.ui:916
msgid "The name it uses when it talks to other computers."
msgstr "他のコンピューターと通信するときに使用する名前です。"

#: usr/lib/live-installer/main.py:432 usr/share/live-installer/interface.ui:900
msgid "Pick a username:"
msgstr "ユーザー名:"

#: usr/lib/live-installer/main.py:433 usr/share/live-installer/interface.ui:948
msgid "Choose a password:"
msgstr "パスワード:"

#: usr/lib/live-installer/main.py:434 usr/share/live-installer/interface.ui:993
msgid "Confirm your password:"
msgstr "パスワードの再入力:"

#: usr/lib/live-installer/main.py:436
msgid "Require my password to log in"
msgstr "ログイン時にパスワードを要求"

#: usr/lib/live-installer/main.py:437
msgid "Encrypt my home folder"
msgstr "ホームフォルダーを暗号化"

#: usr/lib/live-installer/main.py:440
#: usr/share/live-installer/interface.ui:1183
msgid "Automated Installation"
msgstr "自動インストール"

#: usr/lib/live-installer/main.py:441
#, python-format
msgid "Erase a disk and install %s on it."
msgstr "ディスクの中身を消去して %s をインストールします。"

#: usr/lib/live-installer/main.py:442
#: usr/share/live-installer/interface.ui:1238
msgid "Disk:"
msgstr "ディスク:"

#: usr/lib/live-installer/main.py:443 usr/lib/live-installer/main.py:1377
#: usr/share/live-installer/interface.ui:1288
msgid "All data on the selected disk will be erased."
msgstr "選択したディスクのデータはすべて消去されます。"

#: usr/lib/live-installer/main.py:444
msgid "Passphrase"
msgstr "パスフレーズ"

#: usr/lib/live-installer/main.py:445
msgid "Confirm passphrase"
msgstr "パスフレーズの再入力"

#: usr/lib/live-installer/main.py:446
#: usr/share/live-installer/interface.ui:1347
msgid "Manual Partitioning"
msgstr "手動でのパーティショニング"

#: usr/lib/live-installer/main.py:447
#, python-format
msgid "Manually create, resize or choose partitions for %s."
msgstr "自分で %s 用のパーティションを作成・変更・選択します。"

#: usr/lib/live-installer/main.py:449
msgid "Create a swapfile"
msgstr "スワップファイルを作成"

#: usr/lib/live-installer/main.py:450
msgid "Swapfile size (GB)"
msgstr "スワップファイルのサイズ (GB)"

#: usr/lib/live-installer/main.py:451
msgid ""
"Swap is disk space the system uses when its memory is full. It can also be "
"used for hibernation if it is larger than the memory."
msgstr ""
"スワップは、システムのメモリが溢れそうなときに使用されるディスク領域です。ま"
"た、メモリよりも大きな領域が割り当てられている場合は、ハイバネーションにも使"
"用されます。"

#: usr/lib/live-installer/main.py:452
msgid ""
"The defaults on this page suit most computers. If you are unsure, leave them "
"as they are."
msgstr ""
"このページの既定値は、ほとんどのコンピューターにとって適切な構成となっていま"
"す。よく分からなければ、そのままにしておいてください。"

#: usr/lib/live-installer/main.py:453
msgid "Encrypt the system partition"
msgstr "システムパーティションを暗号化"

#: usr/lib/live-installer/main.py:454
msgid ""
"This encrypts the partition the system is installed on, including the "
"swapfile and temporary files. Every user needs the passphrase, which is "
"asked before the boot sequence."
msgstr ""
"システムがインストールされるパーティションを暗号化します (スワップファイルや"
"一時ファイルも対象です)。どのユーザーも、起動時にパスフレーズの入力が求められ"
"ます。"

#: usr/lib/live-installer/main.py:461
#: usr/lib/live-installer/partitioning.py:262
#: usr/share/live-installer/interface.ui:1475
msgid "Edit"
msgstr "編集"

#: usr/lib/live-installer/main.py:462
#: usr/share/live-installer/interface.ui:1502
msgid "Launch GParted"
msgstr "GParted を起動"

#: usr/lib/live-installer/main.py:463
msgid "Refresh"
msgstr "更新"

#: usr/lib/live-installer/main.py:466
msgid "Device"
msgstr "デバイス"

#: usr/lib/live-installer/main.py:467
msgid "Type"
msgstr "種類"

#: usr/lib/live-installer/main.py:468
msgid "Mount point"
msgstr "マウントポイント"

#: usr/lib/live-installer/main.py:469
msgid "Format as"
msgstr "フォーマット形式"

#: usr/lib/live-installer/main.py:470
msgid "Operating system"
msgstr "オペレーティングシステム"

#: usr/lib/live-installer/main.py:471
msgid "Size"
msgstr "サイズ"

#: usr/lib/live-installer/main.py:472
#: usr/lib/live-installer/partitioning.py:613
msgid "Free space"
msgstr "空き容量"

#: usr/lib/live-installer/main.py:476
msgid "Install the GRUB boot menu"
msgstr "GRUB ブートメニューをインストール"

#: usr/lib/live-installer/main.py:477
msgid "Install on:"
msgstr "インストール先:"

#: usr/lib/live-installer/main.py:478
msgid ""
"Change this only if you know your computer starts from another disk, or if "
"you use a different boot manager."
msgstr ""
"コンピューターが別のディスクから起動することが分かっている場合や、別のブート"
"マネージャーを使用する場合にのみ変更してください。"

#: usr/lib/live-installer/main.py:481
#: usr/share/live-installer/interface.ui:2084
msgid ""
"You selected to manage your partitions manually, this feature is for "
"ADVANCED USERS ONLY."
msgstr "手動でパーティションを設定します。これは「上級者向け」です。"

#: usr/lib/live-installer/main.py:482 usr/lib/live-installer/main.py:1271
#: usr/share/live-installer/interface.ui:2122
msgid "Before continuing, mount your target filesystem(s) on /target."
msgstr ""
"先へ進む前に、対象のファイルシステムを /target にマウントしてください。"

#: usr/lib/live-installer/main.py:483
#: usr/share/live-installer/interface.ui:2160
msgid ""
"Do NOT mount virtual devices such as /dev, /proc, /sys, etc on /target/."
msgstr ""
"/dev, /proc, /sys などの仮想デバイスを /target/ にマウント「しないで」くださ"
"い。"

#: usr/lib/live-installer/main.py:484
#: usr/share/live-installer/interface.ui:2198
msgid ""
"During the install, you will be given time to chroot into /target and "
"install any packages that will be needed to boot your new system."
msgstr ""
"インストールの途中で /target へ chroot する機会があります。このとき、新しいシ"
"ステムの起動に必要なパッケージをインストールできます。"

#: usr/lib/live-installer/main.py:485
#: usr/share/live-installer/interface.ui:2236
msgid "During the install, you will be required to write your own /etc/fstab."
msgstr "インストールの途中で /etc/fstab の編集を求められます。"

#: usr/lib/live-installer/main.py:488
#: usr/share/live-installer/interface.ui:2273
msgid "Do the following and then click Next to finish installation:"
msgstr "先へ進む前に、これらの操作を行ってください:"

#: usr/lib/live-installer/main.py:489
#: usr/share/live-installer/interface.ui:2304
msgid ""
"Create /target/etc/fstab for the filesystems as they will be mounted in your "
"new system, matching those currently mounted at /target (without using the /"
"target prefix in the mount paths themselves)."
msgstr ""
"ファイルシステム上に /target/etc/fstab を作成し、その場所を現在マウントしてい"
"る /target に合わせてください (マウントパス自身の前には /target を付けないで"
"ください)。ここで作成した場所は、後に新しいシステムにマウントされます。"

#: usr/lib/live-installer/main.py:490
#: usr/share/live-installer/interface.ui:2342
msgid ""
"Install any packages that may be needed for first boot (mdadm, cryptsetup, "
"dmraid, etc) by calling \"sudo chroot /target\" followed by the relevant apt-"
"get/aptitude installations."
msgstr ""
"適切な apt-get/aptitude の設定後、\"sudo chroot /target\" を実行し、初回起動"
"に必要なパッケージ (mdadm, cryptsetup, dmraid など) をインストールしてくださ"
"い。"

#: usr/lib/live-installer/main.py:491
#: usr/share/live-installer/interface.ui:2380
msgid ""
"Note that in order for update-initramfs to work properly in some cases (such "
"as dm-crypt), you may need to have drives currently mounted using the same "
"block device name as they appear in /target/etc/fstab."
msgstr ""
"一部の状況下 (dm-crypt を使用するなど) で適切に update-initramfs を動作させる"
"には、現在マウントしているドライブを /target/etc/fstab の記述に従い、同じブ"
"ロックデバイス名で設定してください。"

#: usr/lib/live-installer/main.py:492
#: usr/share/live-installer/interface.ui:2418
msgid ""
"Double-check that your /target/etc/fstab is correct, matches what your new "
"system will have at first boot, and matches what is currently mounted at /"
"target."
msgstr ""
"/target/etc/fstab が正しく設定されているか、新しいシステムの初回起動に適した"
"ものか、現在マウントしている /target に誤りがないか、今一度確認してください。"

#: usr/lib/live-installer/main.py:494
msgid "Calculating file indexes ..."
msgstr "ファイルインデックスを計算しています..."

#: usr/lib/live-installer/main.py:505
msgid "The values do not match."
msgstr "値が一致しません。"

#: usr/lib/live-installer/main.py:508
msgid "This field cannot be empty."
msgstr "この欄は空にできません。"

#: usr/lib/live-installer/main.py:511
msgid "This field may not contain space characters."
msgstr "この欄にスペースは使用できません。"

#: usr/lib/live-installer/main.py:514
msgid "This field must be lower case."
msgstr "この欄は小文字にしてください。"

#: usr/lib/live-installer/main.py:517
msgid "This field cannot start or end with a hyphen or period."
msgstr "この欄をハイフン、またはピリオドで開始・終了させることはできません。"

#: usr/lib/live-installer/main.py:521
msgid "The entry is too short."
msgstr "入力が短すぎます。"

#: usr/lib/live-installer/main.py:523
msgid "The entry is too long."
msgstr "入力が長すぎます。"

#: usr/lib/live-installer/main.py:528
msgid "This field contains invalid characters."
msgstr "この欄に無効な文字が使用されています。"

#: usr/lib/live-installer/main.py:679
msgid "Quit?"
msgstr "終了しますか？"

#: usr/lib/live-installer/main.py:679
msgid "Are you sure you want to quit?"
msgstr "終了しますか？"

#: usr/lib/live-installer/main.py:962
#, python-format
msgid ""
"This computer seems to be a laptop. A large swapfile of %(size)s is "
"recommended for hibernation."
msgstr ""
"このコンピューターはノート PC のようです。ハイバネーションを活用するため、大"
"きめな %(size)s のスワップファイルをおすすめします。"

#: usr/lib/live-installer/main.py:964
#, python-format
msgid ""
"This computer seems to be a laptop, but there is not enough disk space for "
"hibernation. A swapfile of %(size)s is recommended."
msgstr ""
"このコンピューターはノート PC のようですが、ハイバネーション用の十分なディス"
"ク領域がありません。%(size)s のスワップファイルをおすすめします。"

#: usr/lib/live-installer/main.py:966
#, python-format
msgid ""
"This computer doesn't seem to be a laptop, so you probably don't need "
"hibernation. A small swapfile of %(size)s is recommended."
msgstr ""
"このコンピューターはノート PC ではないようなので、ハイバネーションも必要ない"
"と思われます。小さめな %(size)s のスワップファイルをおすすめします。"

#: usr/lib/live-installer/main.py:1136
msgid "Unmount required"
msgstr "アンマウントが必要です"

#: usr/lib/live-installer/main.py:1137
