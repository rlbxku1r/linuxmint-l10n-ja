msgid "Hibernation method"
msgstr "ハイバネーション方式"

#: usr/share/mintsysadm/mintsysadm.ui.h:52
msgid "This is method used to power off the computer during hibernation."
msgstr "コンピューターをハイバネーションして電源を切るときに使用する方式です。"

